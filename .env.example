# ==========================================================================
# إعدادات المزامنة — انسخ القيم المناسبة لكل بيئة
# ==========================================================================

# ---------- على السيرفر السحابي (Render/Railway/VPS) ----------
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
DEVICE_ID=cloud
DISABLE_ALERT_SCHEDULER=1
API_TOKEN=ضع-مفتاح-سري-قوي-هنا
# لا تضع SYNC_PEER_URL على السحابة — السحابة لا تبدأ المزامنة، فقط تخدمها

# ---------- على جهاز الديسكتوب (ملف .env.sync داخل DATA_DIR) ----------
# المسار: %LOCALAPPDATA%\gov-hr-suite\.env.sync
# SYNC_PEER_URL=https://your-cloud-api.onrender.com
# SYNC_PEER_NAME=cloud
# SYNC_API_TOKEN=نفس-قيمة-API_TOKEN-السحابية
# DEVICE_ID=desktop  (اختياري — يتولد تلقائياً إن تُرك فارغاً)
